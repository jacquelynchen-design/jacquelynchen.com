{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published portfolio case-study copy",
  "type": "object",
  "required": ["intro", "results"],
  "anyOf": [
    { "required": ["sections"] },
    { "required": ["labels"] }
  ],
  "properties": {
    "intro": { "type": "string", "minLength": 1 },
    "sections": { "$ref": "#/$defs/sectionLabels" },
    "labels": { "$ref": "#/$defs/sectionLabels" },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "string", "minLength": 1 },
              { "type": "string", "minLength": 1 }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  },
  "$defs": {
    "sectionLabels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
